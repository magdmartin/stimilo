source "https://rubygems.org"

# Matches the GitHub Pages builder (Jekyll 3.10). Update with `bundle update github-pages`.
gem "github-pages", "~> 232", group: :jekyll_plugins
gem "webrick" # Ruby 3+ no longer bundles it; needed for `jekyll serve`

group :jekyll_plugins do
  gem "jekyll-remote-theme"
  gem "jekyll-include-cache"
  gem "jekyll-feed"
  gem "jekyll-redirect-from"
  gem "jekyll-sitemap"
end
